# ============================================================
# Backend environment — Usage Metering & Billing Engine
# Copy to .env for development. Never commit real secrets.
# ============================================================

# --- Core ---
# HTTP port for the API (frontend default points at :4000)
PORT=4000
# development | test | production
NODE_ENV=development
# PostgreSQL connection (docker-compose provides both databases; host port
# is 5433 because 5432 is occupied by another local PostgreSQL service)
DATABASE_URL=postgres://billing:billing@localhost:5433/billing
# Separate database used by the automated test suite
TEST_DATABASE_URL=postgres://billing:billing@localhost:5433/billing_test
# Secret used to hash session tokens server-side (min 8 chars; use a long random value)
SESSION_SECRET=replace-me-with-a-long-random-string
# Browser origin allowed to call the API with credentials (Next.js dev server)
CORS_ORIGIN=http://localhost:3000
# pino log level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info
# Proxy hops in front of the API (rate limiting needs the real client IP).
# Numeric hop count (default 1) or an express "trust proxy" preset like loopback.
TRUST_PROXY=1

# --- Stripe (TEST MODE ONLY — never a live key) ---
# Leave unset to disable Stripe features (checkout returns 503 until configured)
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
# Where Stripe sends the browser after Checkout — state changes ONLY via webhooks
STRIPE_SUCCESS_URL=http://localhost:3000/billing?checkout=success
STRIPE_CANCEL_URL=http://localhost:3000/billing?checkout=cancelled
# Optional: seed() stamps plans with this Stripe price id when set
# (checkout falls back to inline price_data when a plan has no price id)
STRIPE_PRO_PRICE_ID=
